{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "web/**/*.html", "use": "@vercel/static" },
    { "src": "web/**/*.css", "use": "@vercel/static" },
    { "src": "web/**/*.js", "use": "@vercel/static" },
    { "src": "web/**/*.jpeg", "use": "@vercel/static" },
    { "src": "web/**/*.svg", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": ["backend/**"] } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    {
      "src": "/(index\\.html|(?:assets|core|features|shell|styles|vendor)/.+\\.(?:html|js|css|jpeg|svg))",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "dest": "/web/$1"
    },
    { "src": "/", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }, "dest": "/web/index.html" }
  ]
}
